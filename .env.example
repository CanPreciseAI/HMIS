# Copy this file to .env.local and enter values from your own Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PROJECT_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/postgres

# Server-side key for Arogya Bot (Google Gemini). Never expose it to the browser.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional override if Google retires the default model again.
# GEMINI_MODEL="gemini-3-flash-preview"
